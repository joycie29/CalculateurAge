<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculateurAge.MainPage"
             Title="Calculateur">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Nom" FontSize="16" />
            <Entry Text="{Binding Nom, Mode=TwoWay}"
                   Placeholder="Votre nom" />

            <Label Text="Date de naissance" FontSize="16" />
            <DatePicker Date="{Binding DateNaissance}" />

            <!-- Fonctionnalité 3 : message d'erreur date future -->
            <Label Text="{Binding ErreurDate}" TextColor="Red"
                   IsVisible="{Binding ErreurVisible}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0" Text="Calculer"
                        Command="{Binding CalculerCommand}" />
                <!-- Fonctionnalité 2 : commande Effacer -->
                <Button Grid.Column="1" Text="Effacer"
                        Command="{Binding EffacerCommand}" />
            </Grid>

            <Label Text="{Binding Resultat}" FontSize="20"
                   IsVisible="{Binding ResultatVisible}" />

            <!-- Fonctionnalité 1 : Majeur / Mineur -->
            <Label Text="{Binding Message}" FontSize="18"
                   FontAttributes="Bold"
                   IsVisible="{Binding ResultatVisible}" />

            <Button Text="Voir le détail"
                    Command="{Binding OuvrirDetailCommand}"
                    IsVisible="{Binding ResultatVisible}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
